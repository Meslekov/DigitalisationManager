<section class="mb-5" aria-labelledby="demo-accounts-title">
    <div class="text-center mb-4">
        <h2 id="demo-accounts-title" class="h3">
            Demo Credentials
        </h2>

        <p class="text-muted mb-0">
            Choose an account to explore the available roles.
        </p>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-danger">
                <div class="card-body d-flex flex-column">
                    <h3 class="h5 text-danger">
                        Administrator
                    </h3>

                    <dl class="mb-4">
                        <dt>Email</dt>
                        <dd>
                            <code>admin@admin.local</code>
                        </dd>

                        <dt>Password</dt>
                        <dd>
                            <code>Admin123!</code>
                        </dd>
                    </dl>

                    <form class="mt-auto"
                          method="post"
                          asp-area="Identity"
                          asp-page="/Account/Login">

                        <input type="hidden"
                               name="Input.Email"
                               value="admin@admin.local" />

                        <input type="hidden"
                               name="Input.Password"
                               value="Admin123!" />

                        <input type="hidden"
                               name="Input.RememberMe"
                               value="false" />

                        <button type="submit"
                                class="btn btn-danger w-100">
                            Log in as Administrator
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-primary">
                <div class="card-body d-flex flex-column">
                    <h3 class="h5 text-primary">
                        Manager
                    </h3>

                    <dl class="mb-4">
                        <dt>Email</dt>
                        <dd>
                            <code>manager@manager.com</code>
                        </dd>

                        <dt>Password</dt>
                        <dd>
                            <code>Manager123!</code>
                        </dd>
                    </dl>

                    <form class="mt-auto"
                          method="post"
                          asp-area="Identity"
                          asp-page="/Account/Login">

                        <input type="hidden"
                               name="Input.Email"
                               value="manager@manager.com" />

                        <input type="hidden"
                               name="Input.Password"
                               value="Manager123!" />

                        <input type="hidden"
                               name="Input.RememberMe"
                               value="false" />

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Log in as Manager
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-secondary">
                <div class="card-body d-flex flex-column">
                    <h3 class="h5">
                        User
                    </h3>

                    <dl class="mb-4">
                        <dt>Email</dt>
                        <dd>
                            <code>user@user.com</code>
                        </dd>

                        <dt>Password</dt>
                        <dd>
                            <code>User123!</code>
                        </dd>
                    </dl>

                    <form class="mt-auto"
                          method="post"
                          asp-area="Identity"
                          asp-page="/Account/Login">

                        <input type="hidden"
                               name="Input.Email"
                               value="user@user.com" />

                        <input type="hidden"
                               name="Input.Password"
                               value="User123!" />

                        <input type="hidden"
                               name="Input.RememberMe"
                               value="false" />

                        <button type="submit"
                                class="btn btn-secondary w-100">
                            Log in as User
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <p class="small text-muted text-center mt-3">
        These accounts and passwords are public and are intended
        only for this demonstration.
    </p>
</section>